    "Clicca una linea (lunghezza), un cerchio (diametro), due punti (distanza) o due linee (angolo), poi scrivi il valore." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a line (length), a circle (diameter), two points (distance) or two lines (angle), then type the value."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击直线（长度）、圆（直径）、两点（距离）或两条线（角度），然后输入数值。"
          }
        }
      }
    },
    "Clicca una linea 3D: diventa perpendicolare al piano dello schizzo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a 3D line: it becomes perpendicular to the sketch plane."
          }
