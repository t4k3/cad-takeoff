    "«%@» è già garantito dal poligono regolare (lati tutti uguali): non aggiunto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» is already guaranteed by the regular polygon (all sides equal): not added."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» è già garantito dal poligono regolare (lati tutti uguali): non aggiunto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已由正多边形隐含保证（所有边相等）：未添加。"
          }
        }
      }
    },
    "«%@» è già garantito dal rettangolo (lati orizzontali e verticali, opposti paralleli e uguali, adiacenti perpendicolari): non aggiunto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» is already guaranteed by the rectangle (horizontal and vertical sides, opposite sides parallel and equal, adjacent sides perpendicular): not added."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» è già garantito dal rettangolo (lati orizzontali e verticali, opposti paralleli e uguali, adiacenti perpendicolari): non aggiunto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已由矩形隐含保证（边水平/垂直、对边平行且相等、邻边垂直）：未添加。"
          }
        }
      }
    },
    "«%@» è già garantito dall'asola (2 lati paralleli e uguali, 2 archi dello stesso raggio): non aggiunto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» is already guaranteed by the slot (2 parallel equal sides, 2 arcs of the same radius): not added."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» è già garantito dall'asola (2 lati paralleli e uguali, 2 archi dello stesso raggio): non aggiunto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已由槽隐含保证（2 条边平行且相等、2 段圆弧半径相同）：未添加。"
          }
        }
      }
    },
    "«%@» è in conflitto con i vincoli esistenti: non aggiunto." : {
