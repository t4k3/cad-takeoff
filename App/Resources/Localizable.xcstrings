    },
    "Clicca una linea dello schizzo come asse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a sketch line as axis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击草图中的直线作为轴。"
          }
        }
      }
    },
    "Clicca una linea e poi la curva: l'estremo più vicino resta sulla curva e la linea le è perpendicolare." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a line and then the curve: the nearest end stays on the curve and the line is perpendicular to it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击一条直线，然后点击曲线：最近的端点落在曲线上，且直线与曲线垂直。"
          }
        }
      }
    },
    "Clicca una linea e poi la curva: l'estremo più vicino resta sulla curva e la linea le è tangente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a line and then the curve: the nearest end stays on the curve and the line is tangent to it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击一条直线，然后点击曲线：最近的端点落在曲线上，且直线与曲线相切。"
          }
