          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接两个零件：点击运动零件上的孔或轴棱边，再点击目标位置；刚性、旋转或滑动"
          }
        }
      }
    },
    "Unisci un simbolo e un'impronta della libreria in un componente da posare (pin ↔ piazzole proposti, da verificare sul datasheet)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine a symbol and a library footprint into a component to place (pin ↔ pads proposed, to verify on the datasheet)"
