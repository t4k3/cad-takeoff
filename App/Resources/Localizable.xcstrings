    "Un clic prende anche gli spigoli che proseguono in tangenza (il contorno di un'asola, il bordo di un cerchio)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One click also picks edges that continue tangentially (the outline of a slot, the rim of a circle)"
          }
        },
