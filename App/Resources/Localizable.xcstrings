    "Scheda da file di produzione" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Board from production files"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自生产文件的板子"
          }
        }
      }
    },
    "Scheda importata dai file di produzione: niente schema, piste da modificare, verifiche DRC o export rigenerato. Qui si sceglie cosa montare in ogni lotto; i corpi dei componenti sono modelli approssimati da controllare." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Board imported from production files: no schematic, trace editing, DRC checks or regenerated export. Here you choose what to assemble in each batch; component bodies are approximate models to check."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从生产文件导入的板子：没有原理图，无法编辑走线、进行 DRC 检查或重新生成导出文件。在这里选择每个批次要装配的内容；元件实体为近似模型，需核对。"
          }
        }
      }
    },
    "scheda importata, %lld componenti, %lld montati nel lotto «%@», %lld lotti" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "imported board, %lld components, %lld fitted in lot «%@», %lld lots"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "scheda importata, %1$lld componenti, %2$lld montati nel lotto «%3$@», %4$lld lotti"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已导入电路板，%lld 个元件，其中 %lld 个已装配于批次「%@」，共 %lld 个批次"
          }
        }
      }
    },
