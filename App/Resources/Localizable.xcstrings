          }
        }
      }
    },
    "Clic per il punto successivo · clic sul primo punto o Invio per chiudere (2 punti: rettangolo) · ⌫ toglie l'ultimo · Esc annulla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click for the next point · click the first point or press Return to close (2 points: rectangle) · ⌫ removes the last · Esc cancels"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击添加下一个点 · 单击第一个点或按回车闭合（2 个点：矩形）· ⌫ 移除最后一个 · Esc 取消"
          }
        }
      }
    },
